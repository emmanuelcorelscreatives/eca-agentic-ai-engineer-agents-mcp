# Copy outside public source; values shown are intentionally not credentials.
TWIN_DATABASE=/data/twin.sqlite
TWIN_RETENTION_DAYS=30
TWIN_RATE_LIMIT=30
TWIN_NOTIFICATION_MODE=local_outbox
TWIN_PUBLIC_BIND=false
# Required only when deliberately binding a public interface behind TLS:
TWIN_AUTH_USERNAME=
TWIN_AUTH_PASSWORD=
# Live SDK requests are separately configured and explicitly invoked:
OPENAI_API_KEY=
ACADEMY_MODEL=
# Enabling this authorizes actual SDK requests on visitor chat; keep false for QA baseline:
TWIN_LIVE_MODEL_ENABLED=false
