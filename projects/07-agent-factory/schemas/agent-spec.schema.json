{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academy:agent-spec:v1",
  "title": "Academy Agent Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "purpose",
    "users",
    "tools",
    "datasets",
    "expected_output",
    "policies",
    "deployment",
    "framework",
    "secret_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,39}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "input_schema",
          "output_schema"
        ],
        "properties": {
          "name": {
            "enum": [
              "catalog_lookup",
              "draft_notification"
            ]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "expected_output": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "deployment": {
      "const": "docker"
    },
    "framework": {
      "enum": [
        "stdlib",
        "agno",
        "mastra"
      ]
    },
    "secret_refs": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$comment": "TypedSpec.parse also enforces exact closed IO schemas, duplicate names, relative dataset paths and literal-credential rejection. JSON Schema alone is insufficient for capability approval."
}
